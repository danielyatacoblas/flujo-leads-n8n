    },
    {
      "parameters": {
        "jsCode": "// Nodo Code de n8n — \"Filtrar publicables\"\n// Deja pasar SOLO los posts aprobados por una persona cuya fecha programada\n// ya llegó. Es la implementación de la política de revisión humana dentro\n// del workflow (espejo de ColaAprobacion.listos_para_publicar).\n\nconst ahora = Date.now();\n\nreturn $input.all().filter((item) => {\n  const f = item.json;\n\n  // Regla de oro: sin aprobación humana explícita, no se publica.\n  if (String(f.estado || '').toLowerCase() !== 'aprobado') return false;\n\n  // Debe constar quién aprobó (trazabilidad).\n  if (!String(f.revisor || '').trim()) return false;\n\n  // Respeta la fecha programada.\n  if (f.fecha_programada) {\n    const programada = Date.parse(f.fecha_programada);\n    if (!isNaN(programada) && ahora < programada) return false;\n  }\n\n  return true;\n}).map((item) => ({\n  json: {\n    ...item.json,\n    publicado_en: new Date().toISOString(),\n  },\n}));\n"
      },
      "id": "code-f",
      "name": "Filtrar publicables",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        300
      ],
      "notes": "Solo pasa lo aprobado por una persona y con fecha cumplida"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r1",
                    "leftValue": "={{ $json.red }}",
                    "rightValue": "instagram",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "instagram"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r2",
                    "leftValue": "={{ $json.red }}",
                    "rightValue": "facebook",
